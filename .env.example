# Copy to .env and fill in. Never commit .env, and never paste these values into chat.

# --- Claude (required for real agent reasoning; without it the system runs in labelled simulated mode)
ANTHROPIC_API_KEY=
AGENCY_MODEL=claude-opus-5-5
AGENCY_EFFORT=medium            # low | medium | high | xhigh | max  (cost vs. depth)
AGENCY_COMPLIANCE_EFFORT=high
AGENCY_INTERVAL_MIN=60          # minutes between autonomous cycles
AGENCY_PAUSED=tiktok            # comma-separated businesses to skip (also toggled in the UI)
COMPLIANCE_MAX_ATTEMPTS=3       # revise-and-recheck rounds before an item is dropped

# --- Trading: HeroFX via TradeLocker (start on the DEMO account)
HEROFX_TL_ENV=https://demo.tradelocker.com    # live: https://live.tradelocker.com (also needs LIVE_TRADING=true)
HEROFX_EMAIL=
HEROFX_PASSWORD=
HEROFX_SERVER=                  # the server name shown on the TradeLocker login screen
HEROFX_ACCOUNT_ID=              # optional, if you have several accounts
LIVE_TRADING=false
TRADING_SYMBOL=US500            # must match HeroFX's symbol name exactly (e.g. US500, NAS100, XAUUSD)
TRADING_ALLOWED_SYMBOLS=US500,NAS100,US30,XAUUSD,USOIL
TRADING_POINT_VALUE=            # USD per 1.0 point per 1 lot; leave blank to use HeroFX's contract size
TRADING_MIN_QTY=0.01
RISK_MAX_CONTRACTS=1            # max lots per trade
RISK_MAX_DAILY_LOSS=300         # USD
RISK_MAX_DRAWDOWN=1500          # USD from equity peak
RISK_MAX_PER_TRADE=150          # USD risk at the stop

# --- Real estate wholesale (12 Midwest states + Florida)
WHOLESALE_STATES_CLEARED=IL,IN,IA,KS,MI,MN,MO,NE,ND,OH,SD,WI,FL
WHOLESALE_LICENSED_STATES=      # states where you (or a partner broker) hold a license
ATTOM_API_KEY=
WHOLESALE_ZIPS=                 # zips to pull from ATTOM, e.g. 43207,46218,33610
WHOLESALE_MIN_FEE=10000

# --- Gmail (wholesale outreach + reading seller replies). Use an app password, not your login password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_DAILY_LIMIT=40
BUSINESS_NAME=
BUSINESS_ADDRESS=               # real postal address; required in every email (CAN-SPAM)

# --- TikTok Shop (paused)
TIKTOK_FEE=0.08
TIKTOK_AFFILIATE=0.15
TIKTOK_MIN_MARGIN=0.30
TIKTOK_MAX_SPEND=500
WHOLESALE_MAX_SPEND=500
